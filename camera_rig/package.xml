<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camera_rig</name>
  <version>0.1.0</version>
  <description>Camera rigs for MC-Calib: Femto Mega opened with pyorbbecsdk (pip install pyorbbecsdk2) or RealSense through their ROS topics; synchronized capture service, preview, RViz clouds</description>
  <maintainer email="timothee.carecchio@inria.fr">Timothée Carecchio</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>inria_calib_interfaces</exec_depend>
  <exec_depend>prl_ur5_robot_configuration</exec_depend>
  <exec_depend>calib_orchestrator</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
