<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="calib_tool"
               params="parent *origin prefix:='' name:=calib_tool cube_size:=0.150
                       mount_face:=0.0505 face_to_face:=0.153">
    <!-- cube_size: outer edge with rims (visual, collision). mount_face: tool0 to the cube face on the mounting.
         face_to_face: mounting face to the opposite face (153 mm along the tool axis, not 150) -->

    <joint name="${prefix}${name}_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}${name}_adapter"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <link name="${prefix}${name}_adapter">
      <visual>
        <geometry>
          <mesh filename="file://$(find calib_tool)/meshes/ee_calib_adaptator.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}${name}_grey">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
        <origin xyz="0.0 0.0 -0.0065" rpy="0.0 0.0 0.0"/>
      </visual>
      <collision>
        <geometry>
          <mesh filename="file://$(find calib_tool)/meshes/ee_calib_adaptator.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <origin xyz="0.0 0.0 -0.0065" rpy="0.0 0.0 0.0"/>
      </collision>
      <!-- approximate, Gazebo drops massless links -->
      <inertial>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>  <!-- middle of the adapter: (57/2 - 9) mm -->
        <mass value="0.1"/>
        <inertia ixx="1e-4" ixy="0.0" ixz="0.0" iyy="1e-4" iyz="0.0" izz="1e-4"/>
      </inertial>
    </link>

    <joint name="${prefix}${name}_cube_joint" type="fixed">
      <parent link="${prefix}${name}_adapter"/>
      <child link="${prefix}${name}_cube"/>
      <origin xyz="0 0 ${mount_face + face_to_face / 2}" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}${name}_cube">
      <visual>
        <geometry>
          <box size="${cube_size} ${cube_size} ${cube_size}"/>
        </geometry>
        <material name="${prefix}${name}_cube_grey">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="${cube_size + 0.02} ${cube_size + 0.02} ${cube_size + 0.02}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.2"/>
        <inertia ixx="${0.2 * cube_size**2 / 6}" ixy="0.0" ixz="0.0"
                 iyy="${0.2 * cube_size**2 / 6}" iyz="0.0" izz="${0.2 * cube_size**2 / 6}"/>
      </inertial>
    </link>

  </xacro:macro>
</robot>
